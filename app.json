{
  "expo": {
    "name": "Travel Expenses",
    "slug": "my-first-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["myfirstapp", "com.arkconsultinggroup.travelexpenses"],
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.arkconsultinggroup.travelexpenses",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.arkconsultinggroup.travelexpenses",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Travel Expenses to access your photos for receipt uploads.",
          "cameraPermission": "Allow Travel Expenses to use the camera to scan receipts.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1766797b-513a-4ac0-816e-8abe4ed63177"
      }
    }
  }
}
