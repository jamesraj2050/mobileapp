# Copy to .env and fill in values.
# Never commit .env

# Turso
EXPO_PUBLIC_TURSO_DATABASE_URL=libsql://your-db.turso.io
EXPO_PUBLIC_TURSO_AUTH_TOKEN=your-token-here

# Cloudflare Worker for receipt uploads (see workers/receipt-upload/README.md)
EXPO_PUBLIC_RECEIPT_UPLOAD_URL=https://receipt-upload.YOUR_SUBDOMAIN.workers.dev
EXPO_PUBLIC_RECEIPT_UPLOAD_SECRET=pick-a-long-random-secret
