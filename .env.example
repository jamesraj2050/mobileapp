# Copy to .env and fill in values.
# Never commit .env

# Cloudflare Worker API (no Turso or R2 secrets in the app)
EXPO_PUBLIC_API_URL=https://receipt-upload.YOUR_SUBDOMAIN.workers.dev

# Google OAuth client IDs (from Google Cloud Console)
# Worker secret GOOGLE_CLIENT_IDS must include these same IDs (comma-separated).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
